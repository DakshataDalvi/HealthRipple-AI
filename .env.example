# HealthRipple AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform API Key
# Required for the interactive map on Overview and Results pages.
# Steps:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an API key
#   3. Enable these APIs in your project:
#        - Maps JavaScript API
#        - (Optional) Map Tiles API for satellite view
#   4. Recommended: restrict the key to your domain in production.
# Without this key, the app falls back to the OpenStreetMap/Leaflet map.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
